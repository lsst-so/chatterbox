# chatterbox configuration.
#
# Copy to config.yaml (gitignored as config.local.yaml, or keep outside the
# repo at ~/.config/chatterbox/config.yaml) and edit. Every value here is a
# default that can be omitted; secrets are never stored in this file, only the
# name of the environment variable to read them from.

# Which Rubin site this instance runs at. One line instead of three, because
# the same site is named differently by each library:
#
#   site       ingest.efd_name   sim.opsim_site   sim.opsim_tokenfile
#   ---------  ----------------  ---------------  -------------------
#   summit     summit_efd        summit           ~/.lsst/summit_rsp
#   base       base_efd          base             ~/.lsst/base_rsp
#   usdf       usdf_efd          usdf             ~/.lsst/usdf_rsp
#   usdf-dev   usdf_efd          usdf-dev         ~/.lsst/usdf_rsp
#
# Any of those three set explicitly below still wins, and both what the site
# supplied and what was overridden are logged at startup. Leave empty to keep
# each setting at its own default. An unknown name is an error rather than a
# silent no-op. There is no "idf": idf_efd exists, but rubin_nights has no
# ConsDB endpoint for it, so set ingest.efd_name directly for that.
site: ""

slack:
  # The bot token must be in this environment variable. A bot token is required
  # rather than an incoming webhook, because webhooks cannot upload the plots.
  # Scopes needed: chat:write, files:write.
  bot_token_env: SLACK_BOT_TOKEN
  channel: "#rso-too-monitor-dev"
  # Where alerts flagged is_test go. Leave empty to send them to `channel`,
  # where they are still visibly marked as tests.
  test_channel: "#rso-too-monitor-dev"
  username: Chatterbox
  icon_emoji: ":boom:"
  # Slack IDs to @-mention on non-test alerts, e.g. ["!subteam^S01ABCDEF"].
  mention: []

ingest:
  # efd:    poll the EFD for new too_alert records (the default).
  # kafka:  subscribe to the ToO producer's output topic via hop-client.
  # files:  watch a directory that forward_alerts.py's FileSender writes into.
  kind: efd

  # Which EFD, and where in it. The alerts are in the lsst.scimma database,
  # not the default one that holds the SAL topics, so the database is set
  # explicitly on the client. efd_name is required -- the client is opened
  # directly as EfdClient(efd_name, db_name=...) -- so name the instance, or
  # set the top-level 'site', which fills it in.
  efd_name: summit_efd     # summit_efd | usdf_efd | idf_efd | base_efd
  efd_database: lsst.scimma
  efd_topic: lsst.scimma.too_alert
  # Each query spans every pixel column of the reward map (12,288 at nside 32),
  # so it is not free -- poll less often than a directory scan.
  efd_poll_interval_s: 10.0
  # Seconds before startup the first query reaches back. 0 means "only alerts
  # from now on". chatterbox keeps no record of what it has already posted, so
  # anything inside this window is re-posted after a restart. To catch an alert
  # that arrived just before you start the service -- e.g. one you just injected
  # -- pass `chatterbox serve --lookback SECONDS` or `serve --since UTC_TIME`
  # instead of changing this default.
  efd_lookback_s: 0.0
  # How far behind the watermark every poll re-reads. A record's EFD time index
  # is the producer's send time, but the relay makes it queryable minutes later;
  # a plain forward-marching window sweeps past the timestamp before the row
  # appears and loses the alert. This margin re-reads recent history each poll so
  # late rows are still caught (the de-dup means nothing is posted twice). Set it
  # comfortably above the real ingest lag; 0 disables it (the old behaviour that
  # silently dropped late alerts).
  efd_revisit_s: 900.0
  # Consecutive failed queries tolerated before the service reports the outage
  # to Slack and stops. One failure is retried.
  efd_max_consecutive_errors: 5

  # Topic names are deployment configuration -- there are none in the
  # rubin-ToO-producer repository -- so this must be filled in for kafka mode.
  # Authentication is delegated to hop-client's own ~/.config/hop/auth.toml.
  kafka_url: ""            # e.g. "kafka://kafka.scimma.org/lsst.rubin-too-alerts"
  kafka_group_id: chatterbox

  watch_dir: ~/.chatterbox/incoming
  poll_interval_s: 1.0
  # Process alerts flagged is_test. Set false to drop them entirely.
  allow_tests: true

dark_hours:
  # Resolution of the accessible-dark-hours map. 64 takes about 0.3 s; 128
  # takes about 1.5 s.
  nside: 128
  step_minutes: 5.0
  # Airmass < 2 corresponds to altitude > 30 degrees.
  airmass_limit: 2.0
  # Must be -12 or -18: the almanac provides those two crossings.
  sun_alt_limit_deg: -12.0
  # Set > 0 to also exclude pixels within this many degrees of the Moon.
  moon_avoidance_deg: 30.0

templates:
  # Template coverage is produced upstream by the incremental templates tooling,
  # which publishes one binary HEALPix FITS map per band here (1 = template
  # exists, 0 = none). This is the only source;
  # `chatterbox refresh-templates` reads it and queries nothing.
  maps_dir: /home/e/ebellm/u/workspace/incremental_templates/template_tools/output
  map_pattern: template_coverage_healpix_{band}_nside{nside}.fits
  nside: 64
  bands: ["u", "g", "r", "i", "z", "y"]
  # Local cache, so the alert path never reads maps_dir directly. Refresh from
  # cron; the cache's timestamp is shown in every post.
  cache_dir: ~/.chatterbox/templates

enrich:
  # For GW alerts the `source` field is the GraceDB superevent id, so the real
  # skymap, distance, FAR and classification can be recovered -- none of which
  # the producer's output record carries. Best-effort and time-bounded; on
  # failure the post falls back to area-based figures and says so.
  gracedb: true
  gracedb_service_url: "https://gracedb.ligo.org/api/"
  timeout_s: 8.0
  cache_dir: ~/.chatterbox/skymaps

sim:
  enabled: true
  # Interpreter for the simulation subprocess; it needs healpy,
  # rubin_scheduler and lsst_survey_sim. Leave empty to use the interpreter
  # running chatterbox, which is usually what you want. `chatterbox doctor`
  # checks whether whatever you set here can actually import them.
  python: /sdf/group/rubin/sw/conda/bin/python 
  # Checkout of lsst_survey_sim. It is added to sys.path, so this works whether
  # the package is pip-installed or used from a clone. `refresh-opsim` needs it
  # too, since the ConsDB fetch lives in that package.
  lsst_survey_sim: ~/Rubin-Observatory/lsst_survey_sim
  ts_config_scheduler: ~/Rubin-Observatory/ts_config_scheduler
  # Checkout of ts_fbs_utils, which defines the ToO follow-up strategies. Its
  # import root is <checkout>/python (LSST layout); that is handled for you.
  # Leave empty if it is pip-installed. Without it, the vendored strategy
  # snapshot is used, which can drift from what the scheduler runs.
  ts_fbs_utils: ~/Rubin-Observatory/ts_fbs_utils
  # Must be the tree containing sim_baseline.
  rubin_sim_data: /sdf/group/rubin/shared/rubin_sim_data/
  # Pre-computed sky brightness, exported as SIMS_SKYBRIGHTNESS_DATA. Empty uses
  # <rubin_sim_data>/skybrightness_pre, which on some site trees holds only a
  # single month-long file -- enough for a recent night, not enough to simulate
  # a follow-up starting tonight, which fails with "MJD is out of range for the
  # files found". Point this at the multi-year set when one is staged, usually
  # <rubin_sim_data>/skybrightness_pre_full.
  skybrightness_data: ""
  # The visit history the simulation starts from. It is fetched from ConsDB
  # with lsst_survey_sim's own fetch_previous_visits and cached here, so there
  # is nothing to stage by hand. It refreshes when the cache is older than
  # opsim_max_age_hours, or when it predates the night being simulated -- so a
  # ToO arriving on a night cron has not covered refreshes it itself.
  # Run `chatterbox refresh-opsim` from cron to keep it warm.
  opsim_cache: ~/.chatterbox/work/opsim.parquet
  opsim_max_age_hours: 24.0     # 0 fetches fresh visits for every simulation
  opsim_tokenfile: ~/.lsst/usdf_rsp   # empty uses the ACCESS_TOKEN env var
  opsim_site: usdf
  # 0 uses the per-alert-class default (GW 20, BBH 50, neutrino 30, SNe/SSO 5).
  nights_override: 0
  timeout_s: 7200.0
  artifact_base_url: ""

  # Filter carousel swap schedule. lsst_survey_sim's built-in schedule ends
  # 2026-03-25 and then falls back to choosing bands from Moon illumination,
  # which silently drops requested u (and often r/i) visits. Set a current
  # schedule here to override it. Whichever path is used is reported in the
  # threaded reply, so an empty setting is safe but visible.
  band_swap_schedule: {}
  #  "2026-04-07": ["u", "g", "r", "i", "z"]
  #  "2026-04-21": ["g", "r", "i", "z", "y"]
  band_swap_end_date: ""

  # Per-night, per-band maps of simulated visit counts with the localization
  # contour drawn on top, posted to a Slack thread of their own. Only nights
  # whose visits overlap the contour are plotted -- including nominal-cadence
  # visits, not just the tagged ToO follow-up, since those cover real
  # localization area too.
  nightly_plots: true
  # Cap on the number of figures, so a 50-night BBH run does not produce 50
  # uploads. 0 means no cap. The count dropped is stated in the message.
  nightly_plots_max_nights: 10
  # Resolution of the count maps. 256 is ~0.05 deg^2 per pixel, fine enough to
  # resolve the 1.75 deg field of view.
  nightly_plots_nside: 256
  # One figure of coverage gained per night, per band, with the running any-band
  # total drawn over it. Separate from nightly_plots: this is a single image
  # whatever the run length, and it covers every night, including the ones the
  # cap above leaves out.
  nightly_coverage_plot: true

paths:
  work_dir: ~/.chatterbox/work

links:
  # No weather link existed in any of the sibling repositories, so these are
  # starting points to be replaced with whatever you actually want on-call
  # people to open.
  weather: "https://www.meteoblue.com/en/weather/week/cerro-pach%c3%b3n_chile_3897347"
  seeing: "https://noirlab.edu/science/observing-noirlab/weather-webcams/cerro-pachon"
  almanac: ""
  observatory_status: ""
  extra: {}
  #  "Nightly digest": "https://usdf-rsp.slac.stanford.edu/times-square/..."
